
/* 1. Configuración general */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f3f2fa;
    color: #17152b;
}

/* 2. Página de inicio de sesión */

.pagina-login {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.contenedor-login {
    width: 100%;
    max-width: 400px;
}

/* 3. Logo */

.logo {
    text-align: center;
    margin-bottom: 30px;
}

.logo h1 {
    font-size: 48px;
    color: #6b46d9;
    letter-spacing: -2px;
}

.logo p {
    color: #77738c;
    margin-top: 5px;
}

/* 4. Tarjeta */

.tarjeta-login {
    background-color: white;
    padding: 35px;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.06);
}

.tarjeta-login h2 {
    text-align: center;
    font-size: 26px;
}

.subtitulo {
    text-align: center;
    color: #77738c;
    font-size: 14px;
    margin-top: 8px;
    margin-bottom: 30px;
}

/* 5. Formularios */

.campo {
    margin-bottom: 20px;
}

.campo label {
    display: block;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 8px;
}

.campo input {
    width: 100%;
    padding: 13px;
    border: 1px solid #dedbe9;
    border-radius: 9px;
    font-size: 15px;
    outline: none;
}

.campo input:focus {
    border-color: #6b46d9;
}

/* 6. Botón */

.boton-principal {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 24px;
    background-color: #2563eb;
    color: white;
    font-size: 22px;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s;
}

.boton-principal:hover {
    background-color: #5535b5;
}

/* 7. Enlace de registro */

.registro {
    text-align: center;
    margin-top: 25px;
    font-size: 14px;
    color: #77738c;
}

.registro a {
    color: #6b46d9;
    text-decoration: none;
    font-weight: bold;
}

/* 8. Mensaje de error */

.mensaje-error {
    background-color: #ffe8e8;
    color: #b42318;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 20px;
}
