# Configurar estas variables en Render, sin subir los valores reales a Git.
DJANGO_SETTINGS_MODULE=INSTAR.production
DJANGO_SECRET_KEY=
PUBLIC_SITE_URL=https://nombre-del-sitio.netlify.app
# Copiar la URL del pooler en modo Session desde Connect en Supabase.
DATABASE_URL=
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=instar-media
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Opcional: objeto privado con datos.json, solo para la primera importación.
BOOTSTRAP_FIXTURE_KEY=

# En Netlify configurar solamente DJANGO_ORIGIN, sin credenciales de Supabase.
# DJANGO_ORIGIN=https://nombre-del-servicio.onrender.com
